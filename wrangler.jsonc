// Cloudflare Workers static-assets deploy for the Expo web build.
// Workers Builds (connected to this repo) runs `npx wrangler deploy` from the
// repo root on every push to main; wrangler runs the `build` command below
// first (expo export + index.html patches), then uploads expo/dist.
{
  "name": "wizard-breaker-game",
  "compatibility_date": "2026-10-13",
  "build": {
    "command": "cd expo && bun install --frozen-lockfile && bun run build:web"
  },
  "assets": {
    "directory": "./expo/dist",
    // Serve index.html for unknown paths so expo-router deep links like /game work.
    "not_found_handling": "single-page-application"
  }
}
